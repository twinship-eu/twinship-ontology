# Vessel-specific instance data (kept local, never committed)
# Use data/* (not data/) so that !data/README.md negation works in git
data/*
!data/README.md

# IMO Compendium Excel is cached in data/ alongside other transient artifacts
# (re-downloadable via extract_imo_compendium.py; committed CSV lives in model/external/imo/)

# Working prompts folder (may contain sensitive vessel data)
prompts/


# Python virtual environments and cache
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
ENV/
env.bak/
venv.bak/

# JetBrains environment
.idea/

# uv
.uv/
uv.lock

# OS files and temp files
.DS_Store
*.swp
*.tmp
*.log

# Test and temporary ontology files
*-test.ttl
/tmp/
/tmp*/

# Ontology build artifacts (auto-generated by merge and conversion scripts)
build/
!build/.gitkeep
*.bak
*.out
*.ttl~
*.owl~

# Prevent build artifacts in source directories
model/*-complete*.ttl
model/*-viz.ttl
model/*-docs*.ttl

# Generated website and documentation
docs/website/
tools/
!docs/website/README.md

# Secrets used to test GitHub workflow locally
.secrets

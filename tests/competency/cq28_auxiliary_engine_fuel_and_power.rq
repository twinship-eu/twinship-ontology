# CQ-28 — What is the Auxiliary Engine System fuel rate (kg/hr) and maximum power (kW) for each vessel?
#
# Coverage: Instance-level. Requires AuxiliaryEngineSystem individuals with ido:partOf a VesselSystem.
# Module:   vessel

PREFIX :         <https://twin-ship.eu/twinship#>
PREFIX ido:      <http://rds.posccaesar.org/ontology/lis14/rdl/>
PREFIX rdfs:     <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:      <http://www.w3.org/2002/07/owl#>
PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>

SELECT ?vessel ?auxEngine ?fuelRateKgPerHr ?maxPowerKW
WHERE {
  ?vessel a :VesselSystem .
  ?auxEngine ido:partOf ?vessel ;
             a :AuxiliaryEngineSystem .
  OPTIONAL { ?auxEngine :twAuxiliaryFuelRateMassNetKgPerHr ?fuelRateKgPerHr }
  OPTIONAL { ?auxEngine :twDieselEnginePowerMaxInKW        ?maxPowerKW      }
}
ORDER BY ?vessel

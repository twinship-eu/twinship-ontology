# CQ-12 — What is the current fuel consumption rate (MT/hr) and total fuel consumption (MT) for each vessel's Main Engine System?
#
# Coverage: Instance-level. Requires MainEngineSystem individuals. AuxiliaryEngineSystem uses twAuxiliaryFuelRateMassNetKgPerHr (kg/hr).
# Module:   vessel

PREFIX :         <https://twin-ship.eu/twinship#>
PREFIX ido:      <http://rds.posccaesar.org/ontology/lis14/rdl/>
PREFIX rdfs:     <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:      <http://www.w3.org/2002/07/owl#>
PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>

SELECT ?vessel ?engine ?fuelConsumptionRateMTPerHr ?fuelConsumptionTotalMT
WHERE {
  ?vessel a :VesselSystem .
  ?engine ido:partOf ?vessel ;
          a :MainEngineSystem .
  OPTIONAL { ?engine :twFuelConsumptionRateInMTPerHr ?fuelConsumptionRateMTPerHr }
  OPTIONAL { ?engine :twFuelConsumptionTotalInMT     ?fuelConsumptionTotalMT     }
}
ORDER BY ?vessel

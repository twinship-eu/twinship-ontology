# CQ-15 — What is the total propulsion power (kW) and auxiliary load power for each vessel?
#
# Coverage: Instance-level. Requires MainEngineSystem and AUXLOAD individuals.
# Module:   vessel

PREFIX :         <https://twin-ship.eu/twinship#>
PREFIX ido:      <http://rds.posccaesar.org/ontology/lis14/rdl/>
PREFIX rdfs:     <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:      <http://www.w3.org/2002/07/owl#>
PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>

SELECT ?vessel
       ?propulsionTotalKW ?hotelLoadKW ?shipServicesPowerKW
WHERE {
  ?vessel a :VesselSystem .
  OPTIONAL {
    ?me ido:partOf ?vessel ;
        a :MainEngineSystem ;
        :twPowerPropulsionTotalInKw ?propulsionTotalKW .
  }
  OPTIONAL {
    ?auxld ido:partOf ?vessel ;
           a :AUXLOAD .
    OPTIONAL { ?auxld :twAUXLDHotelLoadPowerInKW    ?hotelLoadKW        }
    OPTIONAL { ?auxld :twAUXLDShipServicesPowerInKW ?shipServicesPowerKW }
  }
}
ORDER BY ?vessel

# CQ-31 — Which vessels in the fleet are of type RoPax, and what are their shared design parameters for comparative retrofitting decisions?
#
# Coverage: Instance-level. Requires RoPax individuals with hull and displacement data.
# Module:   vessel

PREFIX :         <https://twin-ship.eu/twinship#>
PREFIX ido:      <http://rds.posccaesar.org/ontology/lis14/rdl/>
PREFIX rdfs:     <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:      <http://www.w3.org/2002/07/owl#>
PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>

SELECT ?vessel ?label ?displacementMT ?draftAftM ?draftForeM
WHERE {
  ?vessel a :RoPax .
  OPTIONAL { ?vessel rdfs:label                  ?label          }
  OPTIONAL { ?vessel :twDisplacementMaxInMT       ?displacementMT }
  OPTIONAL { ?vessel :twVesselDraftAftMaxInM      ?draftAftM      }
  OPTIONAL { ?vessel :twVesselDraftForMaxInM      ?draftForeM     }
}
ORDER BY ?vessel

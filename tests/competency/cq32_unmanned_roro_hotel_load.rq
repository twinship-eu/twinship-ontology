# CQ-32 — For an unmanned RoRo vessel, what hull parameters can be modified and how does this affect Hotel Load power?
#
# Coverage: Instance-level. Queries RoRo vessels' AUXLOAD hotel-load power. Bridge/hotel infrastructure removal would set twAUXLDHotelLoadPowerInKW toward 0.
# Module:   vessel

PREFIX :         <https://twin-ship.eu/twinship#>
PREFIX ido:      <http://rds.posccaesar.org/ontology/lis14/rdl/>
PREFIX rdfs:     <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:      <http://www.w3.org/2002/07/owl#>
PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>

SELECT ?vessel ?auxld ?hotelLoadKW ?shipServicesPowerKW
WHERE {
  ?vessel a :RoRo .
  ?auxld ido:partOf ?vessel ;
         a :AUXLOAD .
  OPTIONAL { ?auxld :twAUXLDHotelLoadPowerInKW    ?hotelLoadKW        }
  OPTIONAL { ?auxld :twAUXLDShipServicesPowerInKW ?shipServicesPowerKW }
}
ORDER BY ?vessel

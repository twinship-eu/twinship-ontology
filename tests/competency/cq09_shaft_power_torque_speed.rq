# CQ-09 — What is the maximum shaft power (kW), torque (kNm), and speed (RPM) for the propulsion shaft?
#
# Coverage: Instance-level. Requires MainEngineSystem individuals with shaft data properties.
# Module:   vessel

PREFIX :         <https://twin-ship.eu/twinship#>
PREFIX ido:      <http://rds.posccaesar.org/ontology/lis14/rdl/>
PREFIX rdfs:     <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:      <http://www.w3.org/2002/07/owl#>
PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>

SELECT ?vessel ?engine ?shaftPowerMaxKW ?shaftTorqueMaxKNm ?shaftSpeedMaxRPM
WHERE {
  ?vessel a :VesselSystem .
  ?engine ido:partOf ?vessel ;
          a :MainEngineSystem .
  OPTIONAL { ?engine :twShaftPowerMaxInKW       ?shaftPowerMaxKW  }
  OPTIONAL { ?engine :twShaftTorqueMaxInKnm     ?shaftTorqueMaxKNm }
  OPTIONAL { ?engine :twShaftSpeedMaxInRevPerMin ?shaftSpeedMaxRPM }
}
ORDER BY ?vessel

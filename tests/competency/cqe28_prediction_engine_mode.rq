# CQE-28 — Which engine operational mode was assumed for the predicted voyage?
#
# Coverage: Instance-level. Requires a Prediction, an Assumption linked to it, and a EngineMode linked to that assumption.
# Module:   statistics

PREFIX :         <https://twin-ship.eu/twinship#>
PREFIX ido:      <http://rds.posccaesar.org/ontology/lis14/rdl/>
PREFIX rdfs:     <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:      <http://www.w3.org/2002/07/owl#>
PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>


SELECT ?prediction ?assumption ?engineMode
WHERE {
	?prediction a :Prediction ;
							:hasAssumption ?assumption .
	?assumption a :Assumption ;
							:hasEngineMode ?engineMode .
	?engineMode a :EngineMode .
}
ORDER BY ?prediction ?engineMode

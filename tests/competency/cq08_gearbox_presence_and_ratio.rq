# CQ-08 — Is a Gearbox System present, and what is the gearbox ratio and efficiency for each vessel?
#
# Coverage: Instance-level. Note: twGearboxRatio is xsd:string; no gearbox efficiency property is currently defined.
# Module:   vessel

PREFIX :         <https://twin-ship.eu/twinship#>
PREFIX ido:      <http://rds.posccaesar.org/ontology/lis14/rdl/>
PREFIX rdfs:     <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:      <http://www.w3.org/2002/07/owl#>
PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>

SELECT ?vessel ?gearbox ?gearboxType ?ratio
WHERE {
  ?vessel a :VesselSystem .
  ?gearbox ido:partOf ?vessel ;
           a ?gearboxType .
  ?gearboxType rdfs:subClassOf* :GearboxSystem .
  FILTER (isIRI(?gearboxType))
  OPTIONAL { ?gearbox :twGearboxRatio ?ratio }
}
ORDER BY ?vessel ?gearboxType

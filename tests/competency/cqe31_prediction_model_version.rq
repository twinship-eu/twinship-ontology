# CQE-31 — Which version of the statistical model generated this prediction?
#
# Coverage: Instance-level. Requires a Prediction linked to a VesselPerformanceModel with a VersionNumber.
# Module:   statistics

PREFIX :         <https://twin-ship.eu/twinship#>
PREFIX ido:      <http://rds.posccaesar.org/ontology/lis14/rdl/>
PREFIX rdfs:     <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:      <http://www.w3.org/2002/07/owl#>
PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>

SELECT ?prediction ?model ?version
WHERE {
	?prediction a :Prediction ;
							:wasGeneratedByPredictionProcess ?process .
	?process a :PredictionProcess ;
					 :hasPerformanceModel ?model .
	?model a :VesselPerformanceModel ;
				 :hasModelCard ?modelCard .
	?modelCard a :ModelCard ;
						 :hasPart ?modelDetailSection .
	?modelDetailSection a :ModelDetailSection ;
											:hasVersion ?version .
	?version a :VersionNumber .
}
ORDER BY ?prediction ?model ?version

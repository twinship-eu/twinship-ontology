# CQ-04 — What Efficiency Enhancement System components are installed on each vessel?
#
# Coverage: Instance-level. Expects EfficiencyEnhancementSystem subclass individuals with ido:partOf a VesselSystem.
# Module:   vessel

PREFIX :         <https://twin-ship.eu/twinship#>
PREFIX ido:      <http://rds.posccaesar.org/ontology/lis14/rdl/>
PREFIX rdfs:     <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:      <http://www.w3.org/2002/07/owl#>
PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>

SELECT ?vessel ?component ?componentType
WHERE {
  ?vessel a :VesselSystem .
  ?component ido:partOf ?vessel ;
             a ?componentType .
  ?componentType rdfs:subClassOf* :EfficiencyEnhancementSystem .
  FILTER (isIRI(?componentType))
}
ORDER BY ?vessel ?componentType

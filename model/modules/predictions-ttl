#################################################################
#
#    Object Properties
#
#################################################################

:hasFeatureContribution a owl:ObjectProperty ;
    rdfs:label "has feature contribution"@en ;
    rdfs:comment "Relates a prediction to feature contribution."@en ;
    rdfs:range :twFeatureContribution .


:predicts a owl:ObjectProperty ;
    rdfs:label "Predicts"@en ;
    rdfs:comment "Relates a prediction to target parameter."@en ;
    rdfs:range :TwinShipInformationObject .


:generatedPrediction a owl:ObjectProperty ;
    rdfs:label "Generated Prediction"@en ;
    rdfs:comment "Relates an execution to a prediction."@en ;
    rdfs:range :twPrediction .


:trainedOnDataset a owl:ObjectProperty ;
    rdfs:label "Trained on Dataset"@en ;
    rdfs:comment "Relates a statistical model to the dataset used for training."@en ;
    rdfs:range :twDataset .


:executesModel a owl:ObjectProperty ;
    rdfs:label "Executes Model"@en ;
    rdfs:comment "Relates an execution to the executed statistical model."@en ;
    rdfs:range :twStatisticalModel .



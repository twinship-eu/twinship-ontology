        [ a owl:Restriction ; owl:onProperty :hasTBD ; owl:someValuesFrom :TBD ],
        [ a owl:Restriction ; owl:onProperty :hasTBD ; owl:someValuesFrom :TBD ],
        [ a owl:Restriction ; owl:onProperty :hasTBD ; owl:someValuesFrom :TBD ] .
    #skos:notation "IMO0359" ;
    #skos:altLabel "Wind speed" ;
    #dcterms:description "The measure of wind speed." ;
    #dcterms:source <https://www.imo.org/> .



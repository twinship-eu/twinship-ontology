<https://twin-ship.eu/twinship/prediction> a owl:Ontology ;
    owl:versionIRI <https://twin-ship.eu/twinship/prediction/0.0.1> ;
    dcterms:title "TwinShip Prediction Module"@en ;
    dcterms:description "This module defines TwinShip-native prediction concepts for vessel operational analysis. The module does not import VesselAI or DUL. "@en ;
    dcterms:creator "TwinShip Project" ;
    dcterms:created "2026-06-22"^^xsd:date ;
    dcterms:modified "2026-06-26"^^xsd:date ;
    dcterms:license <https://opensource.org/licenses/MIT> ;
    owl:versionInfo "0.0.1" ;
    owl:imports <https://twin-ship.eu/twinship/base>,
        <https://twin-ship.eu/twinship/operational-modes>,
        <https://twin-ship.eu/twinship/weather-conditions> ;
    rdfs:comment "TwinShip-native estimation, prediction and statistical models module. This module does not import VesselAI, DUL, GeoSPARQL, or OWL-Time."@en .


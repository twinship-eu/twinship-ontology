:twPrediction a owl:Class ;
    rdfs:label "Prediction"@en ;
    rdfs:comment "TBD ~A model output forecasting future states or values~. Extends TwinShipInformationObject in the IDO-aligned TwinShip ontology. "@en ;
    rdfs:subClassOf :TwinShipInformationObject ,

        [ a owl:Restriction ; owl:onProperty :twConfidanceLevel         ; owl:someValuesFrom xsd:decimal              ],
        [ a owl:Restriction ; owl:onProperty :twLowerBound              ; owl:someValuesFrom xsd:dateTime             ],
        [ a owl:Restriction ; owl:onProperty :twUpperBound              ; owl:someValuesFrom xsd:dateTime             ],
        [ a owl:Restriction ; owl:onProperty :twStandardDeviation       ; owl:someValuesFrom xsd:string               ],
        [ a owl:Restriction ; owl:onProperty :hasFeatureContribution    ; owl:someValuesFrom :twFeatureContribution ] .
    #skos:notation "IMO0359" ;
    #skos:altLabel "Wind speed" ;
    #dcterms:description "The measure of wind speed." ;
    #dcterms:source <https://www.imo.org/> .


:twStatisticalModel a owl:Class ;
    rdfs:label "Statistical Model"@en ;
    rdfs:comment "TBD ~A parameterized statistical model or algorithm artifact~. Extends TwinShipInformationObject in the IDO-aligned TwinShip ontology. "@en ;

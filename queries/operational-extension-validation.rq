# ============================================================
# Query 9 — Validate class hierarchy for operational extension
# ============================================================
# Checks that all new module classes have the expected superclasses.

# SELECT ?class ?superclass
# WHERE {
#   VALUES ?class {
#     :Voyage :VoyageLeg :Route :Port
#     :OperatingState :EngineMode
#     :DraftMode :TrimMode :DraftTrimMode
#     :FuelConsumptionObservation
#     :OperationalProfile :SpeedBin :FrequencyDistribution
#     :FuelConsumptionSummary :FuelConsumptionEstimate
#     :FuelConsumptionGapAnalysis :PerformanceDeviation
#     :LoadingCondition :LoadingPreset :DraftCondition :TrimCondition
#     :WindCondition
#   }
#   ?class rdfs:subClassOf ?superclass .
#   FILTER (!isBlank(?superclass))
# }
# ORDER BY ?class ?superclass


# TwinShip Operational Extension — Validation Queries
#
# These SPARQL queries validate that the operational-modes and
# operational-context modules have been correctly loaded.
# Run against the complete TwinShip ontology (twinship-core).
#
# Module IRIs:
#   https://twin-ship.eu/twinship/operational-modes
#   https://twin-ship.eu/twinship/operational-context
#
# Prefix conventions match twinship-base.ttl and all modules.

PREFIX : <https://twin-ship.eu/twinship#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# ============================================================
# Query 1 — List all Voyage instances
# (operational-context module)
# ============================================================
# Expected: returns :Voyage class and any named voyage individuals
# when instance data is loaded.

SELECT ?voyage ?label
WHERE {
  ?voyage a :Voyage .
  OPTIONAL { ?voyage rdfs:label ?label }
}
ORDER BY ?voyage

